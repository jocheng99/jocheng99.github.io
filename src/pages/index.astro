---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import TagList from "../components/TagList.astro";
import { getAllCategories, getAllTags, getRecentPosts } from "../utils/blog";
import { taxonomyPath } from "../utils/taxonomy";
import { withBase } from "../utils/paths";

const recentPosts = await getRecentPosts(3);
const categories = await getAllCategories();
const tags = await getAllTags();
const featuredTags = tags.slice(0, 8).map((tag) => tag.name);
---

<BaseLayout title="CoolCheng Blog" description="中文技术博客，记录技术学习、工程实践、游戏记录和个人思考。" path="/">
  <section class="hero-section">
    <div class="hero-copy">
      <p class="eyebrow">Personal Tech Blog</p>
      <h1>CoolCheng Blog</h1>
      <p>一个偏暗色、极简、可迁移的个人博客。这里会记录技术学习、工程实践、AI 工具探索、游戏记录和一些长期思考。</p>
      <div class="hero-actions">
        <a class="button primary" href={withBase("/blog/")}>阅读文章</a>
        <a class="button ghost" href={withBase("/about/")}>关于我</a>
      </div>
    </div>
    <div class="hero-panel" aria-label="博客方向概览">
      <div>
        <span>Tech</span>
        <strong>前端 / 后端 / 工程化</strong>
      </div>
      <div>
        <span>Tools</span>
        <strong>AI 工具 / 自动化 / 静态部署</strong>
      </div>
      <div>
        <span>Life</span>
        <strong>游戏记录 / 学习笔记 / 随笔</strong>
      </div>
    </div>
  </section>

  <section class="content-band">
    <div class="section-heading">
      <p class="eyebrow">Focus</p>
      <h2>近期会写什么</h2>
    </div>
    <div class="focus-grid">
      <article>
        <h3>技术学习记录</h3>
        <p>把框架、工具链、部署和调试过程写清楚，保留真实判断和踩坑过程。</p>
      </article>
      <article>
        <h3>游戏记录</h3>
        <p>保留旧博客里轻松的游戏记录风格，适合截图、游玩笔记和体验复盘。</p>
      </article>
      <article>
        <h3>个人随笔</h3>
        <p>记录长期关注、阶段性选择和博客本身的演进，不追求高频但追求可持续。</p>
      </article>
    </div>
  </section>

  <section class="page-section">
    <div class="section-heading row-heading">
      <div>
        <p class="eyebrow">Latest</p>
        <h2>最近文章</h2>
      </div>
      <a class="text-link" href={withBase("/blog/")}>查看全部</a>
    </div>
    <div class="post-list">
      {recentPosts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <section class="content-band">
    <div class="section-heading row-heading">
      <div>
        <p class="eyebrow">Taxonomy</p>
        <h2>分类入口</h2>
      </div>
      <a class="text-link" href={withBase("/categories/")}>全部分类</a>
    </div>
    <div class="category-grid">
      {categories.map((category) => (
        <a class="category-card" href={withBase(taxonomyPath("categories", category.name))}>
          <span>{category.name}</span>
          <strong>{category.count} 篇</strong>
        </a>
      ))}
    </div>
  </section>

  <section class="page-section split-section">
    <div>
      <p class="eyebrow">Tags</p>
      <h2>精选标签</h2>
      <TagList tags={featuredTags} />
    </div>
    <div class="game-entry">
      <p class="eyebrow">Game Log</p>
      <h2>游戏记录入口</h2>
      <p>从塞尔达开始，保留旧博客中更轻松的记录方式。</p>
      <a class="button ghost" href={withBase(taxonomyPath("categories", "游戏"))}>查看游戏记录</a>
    </div>
  </section>
</BaseLayout>
