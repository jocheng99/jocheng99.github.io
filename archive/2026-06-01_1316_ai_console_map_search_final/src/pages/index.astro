---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import TagList from "../components/TagList.astro";
import { getAllCategories, getAllPosts, getAllSeries, getAllTags, getRecentPosts, postSlug } from "../utils/blog";
import { taxonomyPath } from "../utils/taxonomy";
import { SITE_VERSION, withBase } from "../utils/paths";

const posts = await getAllPosts();
const recentPosts = await getRecentPosts(3);
const categories = await getAllCategories();
const tags = await getAllTags();
const series = await getAllSeries();
const featuredTags = tags.slice(0, 8).map((tag) => tag.name);
const sourcePipeline = [
  {
    key: "inbox",
    label: "收集",
    status: "ready",
    title: "收集素材",
    text: "把笔记、截图、链接或一组资料先收进 inbox，保留来源和上下文。",
    log: "collect notes: reference_materials/inbox"
  },
  {
    key: "draft",
    label: "整理",
    status: "running",
    title: "整理成稿",
    text: "把材料重组为可阅读的文章结构，补齐标题、摘要和上下文。",
    log: "draft notes -> Astro markdown"
  },
  {
    key: "review",
    label: "检查",
    status: "hold",
    title: "本地检查",
    text: "本地构建、预览、检查搜索索引和链接，确认后再进入定稿流程。",
    log: "check: build, preview, search"
  },
  {
    key: "publish",
    label: "发布",
    status: "done",
    title: "固化并上线",
    text: "确认版写入 archive，提交推送到 GitHub Pages，线上保持纯静态稳定访问。",
    log: "deploy target: GitHub Pages /"
  }
];
const consoleLogs = [
  "[notes] source material accepted",
  "[draft] article structure prepared",
  "[check] build:search validates pages and index",
  "[deploy] static output ships to GitHub Pages"
];
---

<BaseLayout title="CoolCheng Blog" description="记录技术、工具、游戏和日常思考的个人静态博客。" path="/">
  <section class="hero-section dashboard-hero">
    <div class="hero-copy">
      <p class="eyebrow">Personal Blog</p>
      <h1>CoolCheng Blog</h1>
      <p>记录技术工具、项目实践、游戏和一些日常思考。部分内容会用 AI 辅助整理素材，但整体阅读体验保持普通博客的清爽节奏。</p>
      <div class="hero-actions">
        <a class="button primary" href={withBase("/blog/")}>阅读文章</a>
        <a class="button ghost" href={withBase("/search/")}>搜索内容</a>
        <a class="button ghost" href={withBase("/map/")}>文章地图</a>
      </div>
    </div>
    <aside class="console-window hero-console" aria-label="博客状态面板">
      <div class="console-titlebar">
        <div class="window-lights" aria-hidden="true">
          <span class="status-light alert"></span>
          <span class="status-light hold"></span>
          <span class="status-light online"></span>
        </div>
        <span>blog-console</span>
        <code>{SITE_VERSION}</code>
      </div>
      <div class="console-status-grid">
        <div>
          <span class="status-light online" aria-hidden="true"></span>
          <strong>posts</strong>
          <p>{posts.length} published</p>
        </div>
        <div>
          <span class="status-light running" aria-hidden="true"></span>
          <strong>series</strong>
          <p>{series.length} routes</p>
        </div>
        <div>
          <span class="status-light hold" aria-hidden="true"></span>
          <strong>search</strong>
          <p>pagefind ready</p>
        </div>
      </div>
      <ol class="console-log">
        {consoleLogs.map((item) => <li>{item}</li>)}
      </ol>
    </aside>
  </section>

  <section class="content-band">
    <div class="section-heading row-heading">
      <div>
        <p class="eyebrow">Workbench</p>
        <h2>内容工作台</h2>
      </div>
      <a class="text-link" href={withBase("/archive/")}>查看归档</a>
    </div>
    <div class="dashboard-grid">
      <section class="metric-strip" aria-label="博客状态">
        <div>
          <span class="status-light online" aria-hidden="true"></span>
          <span>{posts.length}</span>
          <p>已发布文章</p>
        </div>
        <div>
          <span class="status-light running" aria-hidden="true"></span>
          <span>{series.length}</span>
          <p>文章系列</p>
        </div>
        <div>
          <span class="status-light hold" aria-hidden="true"></span>
          <span>{tags.length}</span>
          <p>内容标签</p>
        </div>
        <div>
          <span class="status-light done" aria-hidden="true"></span>
          <span>{categories.length}</span>
          <p>内容分类</p>
        </div>
      </section>

      <section class="workflow-console is-playing" aria-label="文章整理流程" data-workflow-console>
        <div class="console-titlebar compact">
          <div class="window-lights" aria-hidden="true">
            <span class="status-light online"></span>
            <span class="status-light running"></span>
            <span class="status-light hold"></span>
          </div>
          <span>blog.workflow</span>
          <code>{SITE_VERSION}</code>
        </div>
        <div class="workflow-tabs" role="tablist" aria-label="文章整理阶段">
          {sourcePipeline.map((step, index) => (
            <button
              type="button"
              role="tab"
              class={index === 0 ? "active" : ""}
              aria-selected={index === 0 ? "true" : "false"}
              data-workflow-step={step.key}
              data-workflow-index={index}
            >
              <span class={`status-light ${step.status}`} aria-hidden="true"></span>
              <span>{step.label}</span>
            </button>
          ))}
        </div>
        <div class="workflow-progress" aria-hidden="true">
          <span data-workflow-progress></span>
        </div>
        <div class="workflow-stage" aria-live="polite">
          {sourcePipeline.map((step, index) => (
            <article class={index === 0 ? "active" : ""} data-workflow-panel={step.key}>
              <p class="project-kicker">{String(index + 1).padStart(2, "0")}</p>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
              <pre class="inline-log"><code>{step.log}</code></pre>
            </article>
          ))}
        </div>
      </section>
    </div>
  </section>

  <section class="page-section">
    <div class="section-heading row-heading">
      <div>
        <p class="eyebrow">Latest</p>
        <h2>最近发布</h2>
      </div>
      <a class="text-link" href={withBase("/blog/")}>查看全部</a>
    </div>
    <div class="post-list">
      {recentPosts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <section class="content-band">
    <div class="section-heading row-heading">
      <div>
        <p class="eyebrow">Series</p>
        <h2>文章系列</h2>
      </div>
      <div class="heading-actions">
        <a class="text-link" href={withBase("/tags/")}>全部标签</a>
        <a class="text-link" href={withBase("/map/")}>文章地图</a>
      </div>
    </div>
    <div class="series-grid">
      {series.slice(0, 3).map((item) => (
        <article class="series-card">
          <p class="project-kicker">{item.posts.length} 篇</p>
          <h3>{item.name}</h3>
          <ol>
            {item.posts.slice(0, 4).map((post) => (
              <li><a href={withBase(`/blog/${postSlug(post)}/`)}>{post.data.title}</a></li>
            ))}
          </ol>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section split-section">
    <div>
      <p class="eyebrow">Tags</p>
      <h2>精选标签</h2>
      <TagList tags={featuredTags} />
    </div>
    <div class="game-entry">
      <p class="eyebrow">Game Log</p>
      <h2>游戏记录入口</h2>
      <p>从塞尔达开始，保留旧博客中更轻松的记录方式。</p>
      <a class="button ghost" href={withBase(taxonomyPath("categories", "游戏"))}>查看游戏记录</a>
    </div>
  </section>

  <script>
    const workflow = document.querySelector("[data-workflow-console]");
    const tabs = Array.from(document.querySelectorAll("[data-workflow-step]"));
    const panels = Array.from(document.querySelectorAll("[data-workflow-panel]"));
    const progress = document.querySelector("[data-workflow-progress]");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const stepDuration = 5000;
    const resumeDelay = 20000;
    let activeIndex = Math.max(0, tabs.findIndex((tab) => tab.classList.contains("active")));
    let autoplayTimer;
    let resumeTimer;

    function restartProgress() {
      if (!progress || reduceMotion) return;
      progress.style.animation = "none";
      progress.getBoundingClientRect();
      progress.style.animation = "";
    }

    function activateStep(index) {
      activeIndex = (index + tabs.length) % tabs.length;
      const activeTab = tabs[activeIndex];
      const key = activeTab?.getAttribute("data-workflow-step");

      tabs.forEach((tab, tabIndex) => {
        const isActive = tabIndex === activeIndex;
        tab.classList.toggle("active", isActive);
        tab.setAttribute("aria-selected", String(isActive));
      });

      panels.forEach((panel) => {
        panel.classList.toggle("active", panel.getAttribute("data-workflow-panel") === key);
      });

      restartProgress();
    }

    function stopAutoplay() {
      window.clearTimeout(autoplayTimer);
      workflow?.classList.remove("is-playing");
      workflow?.classList.add("is-paused");
    }

    function scheduleNextStep() {
      window.clearTimeout(autoplayTimer);
      autoplayTimer = window.setTimeout(() => {
        activateStep(activeIndex + 1);
        scheduleNextStep();
      }, stepDuration);
    }

    function startAutoplay() {
      if (reduceMotion || tabs.length <= 1) return;
      window.clearTimeout(resumeTimer);
      workflow?.classList.remove("is-paused");
      workflow?.classList.add("is-playing");
      restartProgress();
      scheduleNextStep();
    }

    function pauseForManualReview() {
      stopAutoplay();
      window.clearTimeout(resumeTimer);
      if (!reduceMotion) {
        resumeTimer = window.setTimeout(() => {
          startAutoplay();
        }, resumeDelay);
      }
    }

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const index = Number(tab.getAttribute("data-workflow-index") || 0);
        activateStep(index);
        pauseForManualReview();
      });
    });

    startAutoplay();
  </script>
</BaseLayout>
