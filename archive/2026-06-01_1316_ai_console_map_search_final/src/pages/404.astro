---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/paths";
---

<BaseLayout title="页面未找到" description="CoolCheng Blog 404 页面。" path="/404.html">
  <section class="simple-page not-found-page">
    <p class="eyebrow">404</p>
    <h1>页面没有找到</h1>
    <p>链接可能已经失效，或者旧 Hexo 地址尚未迁移到新博客。</p>
    <div class="hero-actions">
      <a class="button primary" href={withBase("/")}>返回首页</a>
      <a class="button ghost" href={withBase("/archive/")}>查看归档</a>
    </div>
  </section>
</BaseLayout>
