---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchHint from "../components/SearchHint.astro";
import { getAllCategories, getAllSeries, getAllTags } from "../utils/blog";
import { taxonomyPath } from "../utils/taxonomy";
import { withBase } from "../utils/paths";

const pagefindBase = withBase("/pagefind/");
const categories = await getAllCategories();
const series = await getAllSeries();
const tags = await getAllTags();
const quickTerms = [
  ...series.map((item) => item.name),
  ...tags.slice(0, 6).map((tag) => tag.name)
].slice(0, 8);
---

<BaseLayout title="站内搜索" description="搜索 CoolCheng Blog 的文章、系列和分类。" path="/search/">
  <section class="simple-page search-page">
    <p class="eyebrow">Search</p>
    <h1>站内搜索</h1>
    <p>检索文章标题、摘要和正文，也可以从常用主题、系列和分类直接进入。</p>

    <div class="search-tools">
      <section>
        <h2>常用主题</h2>
        <div class="search-chip-list">
          {quickTerms.map((term) => (
            <button type="button" data-search-term={term}>{term}</button>
          ))}
        </div>
      </section>
      <section>
        <h2>系列</h2>
        <div class="search-link-list">
          {series.map((item, index) => (
            <a href={withBase(`/map/#series-${index + 1}`)}>{item.name}<span>{item.posts.length}</span></a>
          ))}
        </div>
      </section>
      <section>
        <h2>分类</h2>
        <div class="search-link-list">
          {categories.map((category) => (
            <a href={withBase(taxonomyPath("categories", category.name))}>{category.name}<span>{category.count}</span></a>
          ))}
        </div>
      </section>
    </div>

    <link rel="stylesheet" href={`${pagefindBase}pagefind-ui.css`} />
    <div id="search" class="pagefind-ui" data-pagefind-ignore></div>
    <SearchHint />
  </section>
  <script define:vars={{ pagefindBase }}>
    const target = document.querySelector("#search");
    const searchButtons = document.querySelectorAll("[data-search-term]");

    function runSearch(term) {
      let attempts = 0;
      const apply = () => {
        const input = document.querySelector(".pagefind-ui__search-input");
        if (!input) return false;
        input.value = term;
        input.dispatchEvent(new Event("input", { bubbles: true }));
        input.focus();
        return true;
      };

      if (apply()) return;
      const timer = window.setInterval(() => {
        attempts += 1;
        if (apply() || attempts > 24) window.clearInterval(timer);
      }, 50);
    }

    searchButtons.forEach((button) => {
      button.addEventListener("click", () => {
        runSearch(button.getAttribute("data-search-term") || "");
      });
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "/" || event.ctrlKey || event.metaKey || event.altKey) return;
      const active = document.activeElement;
      if (active instanceof HTMLInputElement || active instanceof HTMLTextAreaElement) return;
      const input = document.querySelector(".pagefind-ui__search-input");
      if (!input) return;
      event.preventDefault();
      input.focus();
    });

    if (target) {
      const script = document.createElement("script");
      script.src = pagefindBase + "pagefind-ui.js";
      script.onload = () => {
        if (window.PagefindUI) {
          new window.PagefindUI({
            element: "#search",
            showSubResults: true,
            translations: {
              placeholder: "搜索文章",
              zero_results: "没有找到匹配结果",
              clear_search: "清除搜索"
            }
          });
        } else {
          target.innerHTML = "<p class='search-missing'>Pagefind UI 已加载，但初始化失败。</p>";
        }
      };
      script.onerror = () => {
        target.innerHTML = "<p class='search-missing'>搜索资源加载失败，请确认部署产物包含 pagefind/ 目录。</p>";
      };
      document.head.appendChild(script);
    }
  </script>
</BaseLayout>
