---
import CategoryBadge from "./CategoryBadge.astro";
import TagList from "./TagList.astro";
import { formatDate, postSlug, type BlogPost } from "../utils/blog";
import { DEFAULT_POST_COVER, withBase } from "../utils/paths";

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const href = withBase(`/blog/${postSlug(post)}/`);
const cover = withBase(post.data.cover || DEFAULT_POST_COVER);
const isIllustrationCover = Boolean(post.data.cover?.endsWith(".svg"));
const coverClass = [
  "post-card-cover",
  post.data.cover ? "" : "is-default",
  isIllustrationCover ? "is-illustration" : ""
].filter(Boolean).join(" ");
const coverStyle = isIllustrationCover ? `--post-card-cover-image: url("${cover}")` : undefined;
---

<article class="post-card">
  <img class={coverClass} style={coverStyle} src={cover} alt={`${post.data.title} 封面`} />
  <div class="post-card-body">
    <div class="post-meta">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      <CategoryBadge category={post.data.category} />
    </div>
    <h2><a href={href}>{post.data.title}</a></h2>
    <p>{post.data.description}</p>
    <TagList tags={post.data.tags} />
  </div>
</article>
