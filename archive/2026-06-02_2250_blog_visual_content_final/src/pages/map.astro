---
import BaseLayout from "../layouts/BaseLayout.astro";
import TagList from "../components/TagList.astro";
import { formatDate, getAllCategories, getAllPosts, getAllSeries, getAllTags, postSlug } from "../utils/blog";
import { taxonomyPath } from "../utils/taxonomy";
import { withBase } from "../utils/paths";

const posts = await getAllPosts();
const series = await getAllSeries();
const categories = await getAllCategories();
const tags = await getAllTags();
const seriesNames = new Set(series.map((item) => item.name));
const standalonePosts = posts.filter((post) => !post.data.series || !seriesNames.has(post.data.series));
const categoryGroups = categories.map((category) => ({
  ...category,
  posts: posts.filter((post) => post.data.category === category.name)
}));
const featuredTags = tags.slice(0, 12).map((tag) => tag.name);
---

<BaseLayout title="文章地图" description="按系列、分类和标签浏览 CoolCheng Blog 的文章。" path="/map/">
  <section class="simple-page map-hero">
    <p class="eyebrow">Map</p>
    <h1>文章地图</h1>
    <p>把文章按系列、分类和标签整理在一页里，适合从一个主题顺着读，也适合快速找到旧记录。</p>
    <div class="map-summary" aria-label="文章地图统计">
      <div>
        <span>{posts.length}</span>
        <p>文章</p>
      </div>
      <div>
        <span>{series.length}</span>
        <p>系列</p>
      </div>
      <div>
        <span>{categories.length}</span>
        <p>分类</p>
      </div>
      <div>
        <span>{tags.length}</span>
        <p>标签</p>
      </div>
    </div>
  </section>

  <section class="content-band route-section">
    <div class="section-heading row-heading">
      <div>
        <p class="eyebrow">Series Route</p>
        <h2>系列路线图</h2>
      </div>
      <a class="text-link" href={withBase("/blog/")}>全部文章</a>
    </div>
    <div class="route-grid">
      {series.map((item, seriesIndex) => (
        <article class="route-card" id={`series-${seriesIndex + 1}`}>
          <div class="route-card-head">
            <p class="project-kicker">{item.posts.length} 篇</p>
            <h3>{item.name}</h3>
          </div>
          <ol class="route-list">
            {item.posts.map((post, index) => (
              <li>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <a href={withBase(`/blog/${postSlug(post)}/`)}>{post.data.title}</a>
                  <p>{post.data.description}</p>
                </div>
              </li>
            ))}
          </ol>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section map-section">
    <div class="section-heading row-heading">
      <div>
        <p class="eyebrow">Categories</p>
        <h2>分类索引</h2>
      </div>
      <a class="text-link" href={withBase("/categories/")}>分类页</a>
    </div>
    <div class="map-category-grid">
      {categoryGroups.map((category) => (
        <section class="map-category-card">
          <a class="category-card-title" href={withBase(taxonomyPath("categories", category.name))}>
            <span>{category.name}</span>
            <strong>{category.count} 篇</strong>
          </a>
          <ol>
            {category.posts.slice(0, 4).map((post) => (
              <li>
                <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                <a href={withBase(`/blog/${postSlug(post)}/`)}>{post.data.title}</a>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </section>

  <section class="content-band map-section">
    <div class="section-heading row-heading">
      <div>
        <p class="eyebrow">Tags</p>
        <h2>常用标签</h2>
      </div>
      <a class="text-link" href={withBase("/tags/")}>标签页</a>
    </div>
    <TagList tags={featuredTags} />
  </section>

  {standalonePosts.length > 0 && (
    <section class="page-section map-section">
      <div class="section-heading">
        <p class="eyebrow">Standalone</p>
        <h2>单篇记录</h2>
      </div>
      <div class="standalone-list">
        {standalonePosts.map((post) => (
          <article>
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            <h3><a href={withBase(`/blog/${postSlug(post)}/`)}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
          </article>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
